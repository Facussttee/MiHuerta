# =============================================================================
# CONFIGURACION DEL BOT DE WHATSAPP - MI HUERTA
# Copiá este archivo como ".env" y completá tus datos reales
# =============================================================================

# 1. Datos de tu proyecto en Supabase (Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# 2. URL pública donde subiste la web (Vercel o GitHub Pages)
CATALOG_WEB_URL=https://mihuerta.vercel.app

# 3. Ventana de silencio (Cooldown) en minutos tras enviar el link
# Por defecto 180 minutos (3 horas) para no interrumpir charlas con el dueño
COOLDOWN_MINUTES=180

# 4. Alias de pago de la verdulería que saldrá en el resumen final
PAYMENT_ALIAS=mihuerta.verduras
